FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    XDG_DATA_DIRS=/usr/local/share:/usr/share

# Dependencias nativas de GTK4, Libadwaita, Cairo, Xvfb para testing headless
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    libcairo2-dev \
    libgirepository1.0-dev \
    libgtk-4-1 \
    libgtk-4-dev \
    gir1.2-gtk-4.0 \
    libadwaita-1-0 \
    libadwaita-1-dev \
    gir1.2-adw-1 \
    python3-gi \
    python3-gi-cairo \
    xvfb \
    git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Herramientas de Python base
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Dependencias de ODIN
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt flake8 pytest

# Trigger: publicar imagen CI en GHCR para que ci-odin.yml y azure-pipelines.yml
# puedan usarla como contenedor de ejecucion.
# Re-dispatch: owner en minusculas ya corregido en docker-ci-image.yml.
