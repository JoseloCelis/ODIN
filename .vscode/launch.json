{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🐍 Debug GPU (Híbrido Automatico)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.py",
      "python": "${command:python.interpreterPath}",
      "console": "integratedTerminal",
      "purpose": ["debug-test"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "GTK_A11Y": "none",
        "DISPLAY": "${env:DISPLAY}",
        "WAYLAND_DISPLAY": "${env:WAYLAND_DISPLAY}",
        "XDG_RUNTIME_DIR": "/mnt/wslg/runtime-dir",
        "GSK_RENDERER": "vulkan"
      }
    },
    {
      "name": "🐍 Debug CPU Cairo (Híbrido Automatico)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.py",
      "python": "${command:python.interpreterPath}",
      "console": "integratedTerminal",
      "purpose": ["debug-test"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "GTK_A11Y": "none",
        "LIBGL_ALWAYS_SOFTWARE": "1",
        "GSK_RENDERER": "cairo",
        "DISPLAY": "${env:DISPLAY}",
        "WAYLAND_DISPLAY": "${env:WAYLAND_DISPLAY}",
        "XDG_RUNTIME_DIR": "/mnt/wslg/runtime-dir"
      }
    }
  ]
}
