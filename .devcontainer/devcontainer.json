{
  "name": "ODIN GTK4 - Entorno Híbrido (Mint / WSL2)",
  "build": {
    "dockerfile": "../Dockerfile"
  },
  "workspaceFolder": "/workspaces/ODIN",

  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
    "XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}",
    "PULSE_SERVER": "${localEnv:PULSE_SERVER}",
    "LD_LIBRARY_PATH": "/usr/lib/wsl/lib",
    "GDK_BACKEND": "wayland,x11",
    "GTK_THEME": "Adwaita:dark",
    "GTK_A11Y": "none",
    "GTK_USE_PORTAL": "0",
    "GIO_USE_PORTALS": "0",
    "NO_AT_BRIDGE": "1",
    "MESA_DEBUG": "silent",
    "EGL_LOG_LEVEL": "fatal"
  },

  "runArgs": [
    "--shm-size=2g",
    "--ipc=host",
    
    // Compatibilidad Linux Mint Nativo
    "-v", "/tmp/.X11-unix:/tmp/.X11-unix:rw",
    "--net=host", 

    // Compatibilidad WSL2 / WSLg (Se ignoran de forma segura en Mint)
    "-v", "/usr/lib/wsl:/usr/lib/wsl:ro",
    "-v", "/mnt/wslg:/mnt/wslg:rw"
    //"--gpus", "all"
  ],
  "mounts": [
    // Monta la carpeta personal del host (Mint o WSL) en /host_home dentro del contenedor
    "source=${localEnv:HOME},target=/home,type=bind,consistency=cached",
    "source=/mnt,target=/mnt,type=bind,consistency=cached"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python", 
        "ms-python.debugpy", 
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "PKief.material-icon-theme"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.interpreterPath": "/usr/local/bin/python",
        "python.analysis.useLibraryCodeForTypes": true,
        "python.analysis.typeCheckingMode": "basic"
      }
    }
  },

  "remoteUser": "root",
  
  "postCreateCommand": "git config --global user.email 'jolopez@cenam.mx' && git config --global user.name 'J. Armando López Celis' && python3 -c \"import gi; gi.require_version('Gtk','4.0'); gi.require_version('Adw','1'); from gi.repository import Gtk, Adw; print(f'GTK {Gtk.MAJOR_VERSION} OK, Adw OK')\""
}